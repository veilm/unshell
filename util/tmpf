#!/usr/bin/env python3
import os
import sys
import tempfile


def main() -> int:
    fd, path = tempfile.mkstemp(prefix="ush-", suffix=".tmp")
    try:
        with os.fdopen(fd, "wb") as handle:
            handle.write(sys.stdin.buffer.read())
    except Exception:
        try:
            os.unlink(path)
        except OSError:
            pass
        raise

    sys.stdout.write(path)
    sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
